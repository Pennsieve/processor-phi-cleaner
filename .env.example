# Pennsieve API credentials
PENNSIEVE_API_KEY=your-api-key-here
PENNSIEVE_API_SECRET=your-api-secret-here

# API hosts (defaults shown — uncomment to override)
# PENNSIEVE_API_HOST=https://api.pennsieve.net
# PENNSIEVE_API_HOST2=https://api2.pennsieve.net

# Target dataset
DATASET_ID=N:dataset:your-dataset-id-here

# Processing options
PROCESS_MODE=report
FILE_EXTENSIONS=.lay
RESTRICTED_WORDS=name,last name,first name,mrn,dob,d.o.b,date of birth,patient id

# Logging
VERBOSE=true
